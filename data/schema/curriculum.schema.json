{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "curriculum",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "sessions"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "goal": {
        "type": "string"
      },
      "sessions": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "title",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^P0[0-9]-S[0-9]{2}$"
            },
            "title": {
              "type": "string"
            },
            "goal": {
              "type": "string"
            },
            "status": {
              "enum": [
                "not-started",
                "presented",
                "in-progress",
                "assessed",
                "done"
              ]
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "lessons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}